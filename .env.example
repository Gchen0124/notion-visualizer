# Notion Visualizer Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# EXISTING SETUP (for YearView / internal use)
# ===========================================
NOTION_API_KEY=your_notion_integration_key
NOTION_DAILY_RITUAL_DB=your_daily_ritual_database_id
NOTION_TASK_CALENDAR_DB=your_task_calendar_database_id
NOTION_WEEK_PLANNING_DB=your_week_planning_database_id
NOTION_CANVAS_VIEW_DB=your_canvas_view_database_id

# ===========================================
# OAUTH SETUP (for public Canvas app)
# ===========================================
# To enable OAuth for public users:
# 1. Go to https://www.notion.so/my-integrations
# 2. Create/select your integration → Change to "Public integration"
# 3. Fill in: Company name, Website, Redirect URI, Privacy policy, Terms
# 4. Copy OAuth client ID and secret below

# Public - exposed to browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_NOTION_OAUTH_CLIENT_ID=your_oauth_client_id

# Private - server-side only (used in API route)
NOTION_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Redirect URI (must match what's configured in Notion)
# For local development: http://localhost:3000/api/auth/notion/callback
# For production: https://your-domain.com/api/auth/notion/callback
NEXT_PUBLIC_NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback
